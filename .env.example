# Copy this file to .env. Git ignores .env, so it is never committed.
#
# These are placeholders for the Postgres container on your own laptop. They
# are not real credentials. Staging and pilot values live in GitHub secrets
# and never go in a file in this repo.

POSTGRES_USER=easylecture
POSTGRES_PASSWORD=change-me
POSTGRES_DB=easylecture

# The port on your laptop. Change it if something else already uses 5432.
POSTGRES_PORT=5432

# What an app uses to connect. Keep it in step with the four values above.
DATABASE_URL=postgresql://easylecture:change-me@localhost:5432/easylecture
